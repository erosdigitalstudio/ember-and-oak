---
import Logo from './Logo.astro';
import { nav, site, url } from '../data/site';

const current = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const isCurrent = (href: string) => current === `/${href}`;
---
<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a href={url('')} class="logo-link" aria-label="Ember & Oak — home" data-cursor="hover">
      <Logo />
    </a>

    <nav class="primary-nav" aria-label="Primary">
      <ul role="list">
        {nav.map((item) => (
          <li>
            <a href={url(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <a href={url('reservations/')} class="btn btn--sm" data-magnetic>
        <span class="btn__label">Reserve</span>
      </a>
      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
        data-menu-toggle
      >
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" data-mobile-menu aria-label="Site menu" role="dialog" aria-modal="true" inert>
  <nav aria-label="Mobile">
    <ul role="list">
      <li><a href={url('')} aria-current={current === '/' ? 'page' : undefined}><small>00</small>Home</a></li>
      {nav.map((item, i) => (
        <li>
          <a href={url(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            <small>{String(i + 1).padStart(2, '0')}</small>{item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <div class="mobile-menu__foot">
    <a href={url('reservations/')} class="btn" style="justify-self:start;margin-bottom:1.5rem">
      <span class="btn__label">Reserve a table</span>
    </a>
    <span>{site.address.street}, {site.address.city}</span>
    <a href={site.phoneHref}>{site.phone}</a>
  </div>
</div>
