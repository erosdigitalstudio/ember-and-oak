---
import '@fontsource-variable/cormorant-garamond/wght.css';
import '@fontsource-variable/cormorant-garamond/wght-italic.css';
import '@fontsource-variable/manrope/wght.css';
import '../styles/global.css';

import displayFont from '@fontsource-variable/cormorant-garamond/files/cormorant-garamond-latin-wght-normal.woff2?url';
import sansFont from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Logo from '../components/Logo.astro';
import { site, url } from '../data/site';

interface Props {
  title: string;
  description?: string;
  image?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description = site.description, image = 'og-image.jpg', schema, noindex = false } = Astro.props;

const fullTitle = title === site.name ? `${site.name} · Seattle Steakhouse` : `${title} · ${site.name} Seattle`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(url(image), Astro.site).href;

const restaurantSchema = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: site.name,
  description: site.description,
  servesCuisine: ['Steakhouse', 'Seafood', 'Pacific Northwest'],
  priceRange: '$$$$',
  telephone: '+1-206-555-0142',
  email: site.email,
  url: new URL(url(''), Astro.site).href,
  image: ogImage,
  acceptsReservations: true,
  menu: new URL(url('menu/'), Astro.site).href,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    postalCode: site.address.postal,
    addressCountry: site.address.country,
  },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday'], opens: '17:00', closes: '22:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Friday', 'Saturday'], opens: '17:00', closes: '23:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Sunday', opens: '16:30', closes: '21:30' },
  ],
};
const schemas = [restaurantSchema, ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0b0908" />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <link rel="sitemap" href={url('sitemap-index.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />

    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!reduce) d.classList.add('motion');
        try {
          if (!reduce && !sessionStorage.getItem('eo-visited')) d.classList.add('first-visit');
          if (!reduce && sessionStorage.getItem('eo-transition')) d.classList.add('is-entering');
          sessionStorage.removeItem('eo-transition');
        } catch (e) {}
        // Safety net: never leave content hidden if scripts fail to load.
        setTimeout(function () {
          if (!d.classList.contains('is-ready')) {
            d.classList.add('reveal-fallback');
            d.classList.remove('first-visit', 'is-entering', 'motion');
          }
        }, 3500);
      })();
    </script>

    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <div class="preloader" data-preloader aria-hidden="true">
      <div class="preloader__inner">
        <div class="logo-lockup">
          <Logo size="xl" />
          <span class="logo-lockup__meta">Seattle</span>
        </div>
        <div class="preloader__bar"><span data-preloader-bar></span></div>
        <span class="preloader__count" data-preloader-count>000</span>
      </div>
    </div>

    <div class="curtain" data-curtain aria-hidden="true">
      <div class="curtain__panel curtain__panel--ember" data-curtain-ember></div>
      <div class="curtain__panel" data-curtain-panel></div>
      <div class="curtain__mark" data-curtain-mark><Logo /></div>
    </div>

    <Header />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <Footer />

    <div class="grain" aria-hidden="true"></div>

    <div class="cursor is-hidden" data-cursor-el aria-hidden="true">
      <div class="cursor__ring" data-cursor-ring><span class="cursor__label" data-cursor-label></span></div>
      <div class="cursor__dot" data-cursor-dot></div>
    </div>

    <script>
      import { boot } from '../scripts/main';
      boot();
    </script>
  </body>
</html>
