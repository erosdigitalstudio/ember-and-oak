    align-items: center;
    justify-content: center;
    gap: var(--s-6);
  }
</style>

<script>
  import { gsap, ScrollTrigger, onReady, hasMotion } from '../scripts/main';
  import { initEmbers } from '../scripts/embers';

  const motion = hasMotion();
  const canvas = document.querySelector<HTMLCanvasElement>('[data-embers]');
  if (canvas && motion) initEmbers(canvas);

  if (motion) {
    // Hero: slow settle on load, then the photo deepens and the copy drifts away as you scroll.
    const media = document.querySelector('[data-hero-media]');
    const content = document.querySelector('[data-hero-content]');
    gsap.fromTo(media, { scale: 1.15 }, { scale: 1, duration: 2.8, ease: 'expo.out', delay: 0.1 });
    gsap.to(media, {
      yPercent: 14,
      ease: 'none',
      scrollTrigger: { trigger: '[data-home-hero]', start: 'top top', end: 'bottom top', scrub: true },
    });
    gsap.to(content, {
      yPercent: -18,
      opacity: 0,
      ease: 'none',
      scrollTrigger: { trigger: '[data-home-hero]', start: '30% top', end: 'bottom top', scrub: true },
    });

    // Signatures: pinned horizontal gallery on large screens only.
    const mm = gsap.matchMedia();
    mm.add('(min-width: 1024px)', () => {
      const section = document.querySelector<HTMLElement>('[data-signatures]');
      const track = document.querySelector<HTMLElement>('[data-sig-track]');
      const progress = document.querySelector('[data-sig-progress]');
      if (!section || !track) return;
      const distance = () => track.scrollWidth - window.innerWidth;
      const tween = gsap.to(track, {
        x: () => -distance(),
        ease: 'none',
        scrollTrigger: {
          trigger: section,
          start: 'top top',
          end: () => `+=${distance()}`,
          pin: true,
          scrub: 0.8,
          invalidateOnRefresh: true,
          anticipatePin: 1,
          onUpdate: (self) => gsap.set(progress, { scaleX: self.progress }),
        },
      });
      // Each photo eases in as it enters from the right.
      gsap.utils.toArray<HTMLElement>('.sig-card').forEach((card) => {
        const img = card.querySelector('img');
        gsap.fromTo(
          img,
          { scale: 1.25 },
          {
            scale: 1,
            ease: 'none',
            scrollTrigger: { trigger: card, containerAnimation: tween, start: 'left right', end: 'center center', scrub: true },
          },
        );
      });
    });

    onReady(() => ScrollTrigger.refresh());
  }
</script>
