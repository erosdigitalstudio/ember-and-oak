---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site, url } from '../data/site';
import sideImg from '../assets/img/dark-interior.jpg';
---
<Base
  title="Reservations"
  description="Reserve a table at Ember & Oak, Seattle's Pacific Northwest steakhouse. Choose your date, time and seating, from the dining room to the chef's counter."
>
  <section class="resv">
    <aside class="resv__aside" aria-label="About reservations">
      <div class="resv__aside-media">
        <Image src={sideImg} alt="" widths={[640, 960, 1400]} sizes="(min-width: 1000px) 42vw, 100vw" format="webp" quality={74} loading="eager" fetchpriority="high" />
      </div>
      <div class="resv__aside-content">
        <p class="eyebrow" data-reveal="fade" data-hero>Reservations</p>
        <h1 class="resv__title" data-split="hero">Reserve your <em>table</em></h1>
        <ul class="resv__facts" role="list" data-reveal="up" data-hero data-delay="0.3">
          <li><Icon name="calendar" /> Bookings open 30 days in advance</li>
          <li><Icon name="clock" /> Tuesday – Sunday from 5:00 pm</li>
          <li><Icon name="users" /> Parties of 9+ visit <a href={url('private-dining/')}>Private Dining</a></li>
          <li><Icon name="shirt" /> Smart casual; jackets welcome</li>
        </ul>
      </div>
    </aside>

    <div class="resv__main">
      <div class="booking" data-booking>
        <div class="demo-note">
          <Icon name="info" />
          <p><strong>Demonstration booking system.</strong> Availability is simulated and no reservation is created. Connect a booking provider or backend to go live.</p>
        </div>

        <ol class="steps" role="list" aria-label="Booking progress">
          <li class="steps__item is-current" data-step-ind="1"><span class="steps__n">1</span><span class="steps__label">Date &amp; party</span></li>
          <li class="steps__item" data-step-ind="2"><span class="steps__n">2</span><span class="steps__label">Time &amp; seating</span></li>
          <li class="steps__item" data-step-ind="3"><span class="steps__n">3</span><span class="steps__label">Your details</span></li>
        </ol>

        <form novalidate data-booking-form>
          <!-- STEP 1 -->
          <fieldset class="step" data-step="1">
            <legend class="step__title" tabindex="-1">When, and how many?</legend>

            <div class="party">
              <span class="label" id="party-label">Guests</span>
              <div class="stepper" role="group" aria-labelledby="party-label">
                <button type="button" class="stepper__btn" data-party="-1" aria-label="Fewer guests"><Icon name="minus" /></button>
                <output class="stepper__value tabular" data-party-value aria-live="polite">2</output>
                <button type="button" class="stepper__btn" data-party="1" aria-label="More guests"><Icon name="plus" /></button>
              </div>
              <p class="field__hint" data-party-hint>Up to 8 guests online.</p>
            </div>

            <div class="calendar" data-calendar>
              <div class="calendar__head">
                <button type="button" class="calendar__nav" data-cal-prev aria-label="Previous month"><Icon name="chevron-left" /></button>
                <h2 class="calendar__month" data-cal-month aria-live="polite">Month</h2>
                <button type="button" class="calendar__nav" data-cal-next aria-label="Next month"><Icon name="chevron-right" /></button>
              </div>
              <div class="calendar__dow" aria-hidden="true">
                <span>Su</span><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span>
              </div>
              <div class="calendar__grid" role="grid" aria-labelledby="cal-hint" data-cal-grid></div>
              <p class="field__hint" id="cal-hint">Choose a date. Closed on Mondays. Use arrow keys to move between days.</p>
              <p class="field__error" data-err="date" role="alert"></p>
            </div>

            <div class="step__actions">
              <button type="button" class="btn" data-next="2"><span class="btn__label">Find a time</span><Icon name="arrow-right" /></button>
            </div>
          </fieldset>

          <!-- STEP 2 -->
          <fieldset class="step" data-step="2" hidden>
            <legend class="step__title" tabindex="-1">Choose a time</legend>
            <p class="muted" data-date-label></p>

            <div class="slots" role="radiogroup" aria-label="Available times" data-slots></div>
            <p class="field__error" data-err="time" role="alert"></p>

            <div class="field">
              <span class="label" id="seat-label">Seating preference</span>
              <div class="seats" role="radiogroup" aria-labelledby="seat-label">
                <label class="seat">
                  <input type="radio" name="seating" value="Dining Room" checked />
                  <span class="seat__card"><strong>Dining Room</strong><small>Hearth-side tables, our classic experience</small></span>
                </label>
                <label class="seat">
                  <input type="radio" name="seating" value="Chef’s Counter" />
                  <span class="seat__card"><strong>Chef’s Counter</strong><small>Front row to the fire, up to 4 guests</small></span>
                </label>
                <label class="seat">
                  <input type="radio" name="seating" value="Oak Bar" />
                  <span class="seat__card"><strong>Oak Bar</strong><small>Full menu and cocktails, relaxed</small></span>
                </label>
              </div>
            </div>

            <div class="step__actions">
              <button type="button" class="link" data-back="1"><Icon name="arrow-left" /> Back</button>
              <button type="button" class="btn" data-next="3"><span class="btn__label">Continue</span><Icon name="arrow-right" /></button>
            </div>
          </fieldset>

          <!-- STEP 3 -->
          <fieldset class="step" data-step="3" hidden>
            <legend class="step__title" tabindex="-1">A few details</legend>
            <div class="summary" data-summary aria-live="polite"></div>

            <div class="form-row form-row--2">
              <div class="field">
                <label for="r-first">First name<span class="req" aria-hidden="true">*</span></label>
                <input id="r-first" class="input" name="first" autocomplete="given-name" required data-label="first name" aria-describedby="r-first-err" />
                <p class="field__error" id="r-first-err"></p>
              </div>
              <div class="field">
                <label for="r-last">Last name<span class="req" aria-hidden="true">*</span></label>
                <input id="r-last" class="input" name="last" autocomplete="family-name" required data-label="last name" aria-describedby="r-last-err" />
                <p class="field__error" id="r-last-err"></p>
              </div>
            </div>
            <div class="form-row form-row--2">
              <div class="field">
                <label for="r-email">Email<span class="req" aria-hidden="true">*</span></label>
                <input id="r-email" class="input" name="email" type="email" inputmode="email" autocomplete="email" required data-label="email" aria-describedby="r-email-err" />
                <p class="field__error" id="r-email-err"></p>
              </div>
              <div class="field">
                <label for="r-phone">Mobile phone<span class="req" aria-hidden="true">*</span></label>
                <input
                  id="r-phone"
                  class="input"
                  name="phone"
                  type="tel"
                  inputmode="tel"
                  autocomplete="tel"
                  required
                  pattern="[0-9+()\-\s.]{7,}"
                  data-label="phone number"
                  data-pattern-msg="Please enter a valid phone number, e.g. (206) 555-0100."
                  aria-describedby="r-phone-err r-phone-hint"
                />
                <p class="field__hint" id="r-phone-hint">For a reminder text on the day.</p>
                <p class="field__error" id="r-phone-err"></p>
              </div>
            </div>
            <div class="field">
              <label for="r-occasion">Occasion</label>
              <select id="r-occasion" class="select" name="occasion">
                <option value="">None</option>
                <option>Birthday</option>
                <option>Anniversary</option>
                <option>Business dinner</option>
                <option>Date night</option>
                <option>Celebration</option>
              </select>
            </div>
            <div class="field">
              <label for="r-notes">Allergies or requests</label>
              <textarea id="r-notes" class="textarea" name="notes" rows="3" placeholder="Dietary needs, accessibility, a special surprise…"></textarea>
            </div>

            <div class="step__actions">
              <button type="button" class="link" data-back="2"><Icon name="arrow-left" /> Back</button>
              <button type="submit" class="btn" data-submit><span class="btn__label">Confirm reservation</span></button>
            </div>
            <p class="form-status is-error" role="alert" data-form-status></p>
          </fieldset>
        </form>

        <!-- CONFIRMATION -->
        <div class="confirm" data-confirm hidden tabindex="-1">
          <span class="confirm__seal" aria-hidden="true"><Icon name="flame" size={30} /></span>
          <p class="eyebrow eyebrow--plain">Demo confirmation · <span data-ref class="tabular"></span></p>
          <h2 class="h2">We’ll see you <em>soon</em>, <span data-c-name></span>.</h2>
          <dl class="confirm__details" data-c-details></dl>
          <div class="demo-note">
            <Icon name="info" />
            <p><strong>This is a demonstration.</strong> No table was reserved and no email was sent. In a live version, a confirmation would be emailed to <span data-c-email></span>.</p>
          </div>
          <div class="confirm__actions">
            <button type="button" class="btn btn--ghost" data-ics><span class="btn__label">Add to calendar</span><Icon name="calendar" /></button>
            <button type="button" class="link" data-restart>Make another booking <Icon name="arrow-right" /></button>
          </div>
        </div>

        <p class="booking__help">
          Questions? Call <a href={site.phoneHref}>{site.phone}</a> or write to <a href={`mailto:${site.email}`}>{site.email}</a>.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .resv {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-height: 100svh;
  }
  .resv > * {
    min-width: 0;
  }
  @media (min-width: 1000px) {
    .resv {
      grid-template-columns: 42% minmax(0, 1fr);
    }
  }
  .resv__aside {
    position: relative;
    min-height: 62svh;
    display: grid;
    align-items: end;
    isolation: isolate;
    overflow: hidden;
    padding: calc(var(--header-h) + var(--s-7)) var(--gutter) var(--s-7);
  }
  @media (min-width: 1000px) {
    .resv__aside {
      position: sticky;
      top: 0;
      height: 100svh;
    }
  }
  .resv__aside-media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .resv__aside-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .resv__aside::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgb(11 9 8 / 0.5) 0%, rgb(11 9 8 / 0.35) 40%, rgb(11 9 8 / 0.92) 100%);
  }
  .resv__aside-content {
    display: grid;
    gap: var(--s-5);
  }
  .resv__title {
    font-size: var(--fs-3xl);
    line-height: 0.95;
  }
  .resv__title :global(em) {
    font-style: italic;
    color: var(--accent-strong);
  }
  .resv__facts {
    display: grid;
    gap: var(--s-3);
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }
  .resv__facts li {
    display: flex;
    gap: var(--s-3);
    align-items: center;
  }
  .resv__facts :global(svg) {
    color: var(--accent);
    flex: none;
  }
  .resv__facts a {
    color: var(--accent-strong);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .resv__main {
    padding: var(--s-8) var(--gutter) var(--section);
  }
  @media (min-width: 1000px) {
    .resv__main {
      padding-top: calc(var(--header-h) + var(--s-8));
    }
  }
  .booking {
    max-width: 44rem;
    margin-inline: auto;
    display: grid;
    gap: var(--s-7);
  }

  /* Steps indicator */
  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-3);
  }
  .steps__item {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding-top: var(--s-3);
    border-top: 2px solid var(--line);
    font-size: var(--fs-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-subtle);
    transition: border-color 500ms var(--ease-out), color 500ms var(--ease-out);
  }
  .steps__n {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    flex: none;
    border-radius: 50%;
    border: 1px solid currentColor;
    font-variant-numeric: tabular-nums;
  }
  .steps__item.is-current,
  .steps__item.is-done {
    color: var(--text);
    border-top-color: var(--accent);
  }
  .steps__item.is-done .steps__n {
    background: var(--accent-fill);
    border-color: var(--accent-fill);
    color: var(--on-accent);
  }
  @media (max-width: 560px) {
    .steps__label {
      display: none;
    }
    .steps__item.is-current .steps__label {
      display: inline;
    }
  }

  .step {
    display: grid;
    gap: var(--s-6);
  }
  .step__title {
    font-family: var(--f-display);
    font-size: var(--fs-2xl);
    line-height: 1.05;
    text-transform: none;
    letter-spacing: -0.01em;
    color: var(--text);
    margin-bottom: var(--s-2);
    padding: 0;
  }
  .step__title:focus {
    outline: none;
  }
  .step__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
  }
  .step__actions .btn:only-child {
    margin-left: auto;
  }

  /* Party stepper */
  .party {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-6);
  }
  .stepper {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
  }
  .stepper__btn {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    color: var(--accent);
    transition: background-color var(--d-base), color var(--d-base), transform var(--d-fast);
  }
  .stepper__btn:hover:not(:disabled) {
    background: rgb(192 122 75 / 0.15);
  }
  .stepper__btn:active:not(:disabled) {
    transform: scale(0.9);
  }
  .stepper__btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }
  .stepper__value {
    min-width: 3ch;
    text-align: center;
    font-family: var(--f-display);
    font-size: var(--fs-xl);
  }

  /* Calendar */
  .calendar {
    display: grid;
    gap: var(--s-3);
    padding: var(--s-5);
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .calendar__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .calendar__month {
    font-size: var(--fs-lg);
  }
  .calendar__nav {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    transition: border-color var(--d-base), background-color var(--d-base);
  }
  .calendar__nav:hover:not(:disabled) {
    border-color: var(--accent);
  }
  .calendar__nav:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }
  .calendar__dow,
  .calendar__grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 4px;
    text-align: center;
  }
  .calendar__dow span {
    font-size: var(--fs-xs);
    letter-spacing: 0.1em;
    color: var(--text-subtle);
    padding-block: var(--s-2);
  }
  .calendar__grid :global(.cal-row) {
    display: contents;
  }
  .calendar__grid :global([role='gridcell']) {
    display: grid;
  }
  .calendar__grid :global(.day) {
    width: 100%;
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    min-height: 40px;
    border-radius: 50%;
    font-variant-numeric: tabular-nums;
    font-size: var(--fs-sm);
    color: var(--text);
    transition: background-color var(--d-base) var(--ease-out), color var(--d-base), transform var(--d-fast);
  }
  .calendar__grid :global(.day:hover:not([aria-disabled='true'])) {
    background: rgb(192 122 75 / 0.18);
  }
  .calendar__grid :global(.day:active:not([aria-disabled='true'])) {
    transform: scale(0.92);
  }
  .calendar__grid :global(.day[aria-disabled='true']) {
    color: var(--text-subtle);
    opacity: 0.45;
    cursor: not-allowed;
    text-decoration: line-through;
    text-decoration-color: rgb(244 237 227 / 0.25);
  }
  .calendar__grid :global(.day.is-today::after) {
    content: '';
    position: absolute;
    bottom: 18%;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--ember-400);
  }
  .calendar__grid :global([aria-selected='true'] > .day) {
    background: var(--accent-fill);
    color: var(--on-accent);
    font-weight: 700;
  }
  .calendar__grid :global(.day-empty) {
    aspect-ratio: 1;
  }

  /* Time slots */
  .slots {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(6.5rem, 1fr));
    gap: var(--s-2);
  }
  .slots :global(.slot) {
    min-height: 48px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    font-variant-numeric: tabular-nums;
    font-size: var(--fs-sm);
    transition: background-color var(--d-base), border-color var(--d-base), color var(--d-base), transform var(--d-fast);
  }
  .slots :global(.slot:hover:not([aria-disabled='true'])) {
    border-color: var(--accent);
  }
  .slots :global(.slot:active:not([aria-disabled='true'])) {
    transform: scale(0.96);
  }
  .slots :global(.slot[aria-checked='true']) {
    background: var(--accent-fill);
    border-color: var(--accent-fill);
    color: var(--on-accent);
    font-weight: 700;
  }
  .slots :global(.slot[aria-disabled='true']) {
    color: var(--text-subtle);
    opacity: 0.4;
    cursor: not-allowed;
    text-decoration: line-through;
  }
  .slots :global(.slots__period) {
    grid-column: 1 / -1;
    font-size: var(--fs-xs);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin-top: var(--s-3);
  }

  /* Seating */
  .seats {
    display: grid;
    gap: var(--s-3);
  }
  @media (min-width: 640px) {
    .seats {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .seat {
    position: relative;
    cursor: pointer;
  }
  .seat input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .seat__card {
    display: grid;
    gap: var(--s-1);
    height: 100%;
    padding: var(--s-4) var(--s-5);
    border: 1px solid var(--line-strong);
    transition: border-color var(--d-base), background-color var(--d-base);
  }
  .seat__card strong {
    font-family: var(--f-display);
    font-weight: 500;
    font-size: var(--fs-lg);
  }
  .seat__card small {
    font-size: var(--fs-sm);
    color: var(--text-subtle);
    line-height: 1.4;
  }
  .seat:hover .seat__card {
    border-color: var(--accent);
  }
  .seat input:checked + .seat__card {
    border-color: var(--accent);
    background: rgb(192 122 75 / 0.12);
    box-shadow: inset 0 0 0 1px var(--accent);
  }
  .seat input:focus-visible + .seat__card {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }

  /* Summary & confirmation */
  .summary {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
    padding: var(--s-4) var(--s-5);
    border-left: 2px solid var(--accent);
    background: var(--surface);
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }
  .summary :global(strong) {
    color: var(--text);
    font-weight: 600;
  }
  .confirm {
    display: grid;
    gap: var(--s-5);
    justify-items: start;
  }
  .confirm:focus {
    outline: none;
  }
  .confirm :global(em) {
    font-style: italic;
    color: var(--accent-strong);
  }
  .confirm__seal {
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 60%, var(--ember-400), var(--copper-700));
    color: var(--ivory-50);
    box-shadow: 0 0 60px rgb(240 90 36 / 0.45);
  }
  .confirm__details {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-5);
    padding-block: var(--s-5);
    border-block: 1px solid var(--line);
  }
  @media (min-width: 640px) {
    .confirm__details {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .confirm__details :global(dt) {
    font-size: var(--fs-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-subtle);
  }
  .confirm__details :global(dd) {
    font-family: var(--f-display);
    font-size: var(--fs-lg);
  }
  .confirm__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-5);
    align-items: center;
  }
  .booking__help {
    font-size: var(--fs-sm);
    color: var(--text-subtle);
  }
  .booking__help a {
    color: var(--text-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>

<script>
  import { gsap, hasMotion, scrollToEl } from '../scripts/main';
  import { enhanceForm, validateForm, setLoading, fakeRequest } from '../scripts/forms';

  const MAX_PARTY = 8;
  const BOOKING_WINDOW = 30;

  const form = document.querySelector<HTMLFormElement>('[data-booking-form]')!;
  const booking = document.querySelector<HTMLElement>('[data-booking]')!;
  const confirmEl = document.querySelector<HTMLElement>('[data-confirm]')!;
  const steps = Array.from(form.querySelectorAll<HTMLFieldSetElement>('[data-step]'));
  const indicators = Array.from(document.querySelectorAll<HTMLElement>('[data-step-ind]'));

  const today = new Date();
  today.setHours(0, 0, 0, 0);
  const lastDay = new Date(today);
  lastDay.setDate(today.getDate() + BOOKING_WINDOW);

  const state = {
    party: 2,
    date: null as Date | null,
    time: '',
    view: new Date(today.getFullYear(), today.getMonth(), 1),
  };

  const fmtLong = (d: Date) => d.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' });
  const sameDay = (a: Date, b: Date) => a.toDateString() === b.toDateString();
  const isClosed = (d: Date) => d.getDay() === 1; // Mondays
  const isBookable = (d: Date) => d >= today && d <= lastDay && !isClosed(d);

  /* ---------- Step navigation ---------- */
  let current = 1;
  const goTo = (n: number) => {
    const from = steps[current - 1];
    const to = steps[n - 1];
    current = n;
    indicators.forEach((ind, i) => {
      ind.classList.toggle('is-current', i === n - 1);
      ind.classList.toggle('is-done', i < n - 1);
      if (i === n - 1) ind.setAttribute('aria-current', 'step');
      else ind.removeAttribute('aria-current');
    });
    from.hidden = true;
    to.hidden = false;
    to.querySelector<HTMLElement>('.step__title')?.focus({ preventScroll: true });
    scrollToEl(booking, -110);
    if (hasMotion()) gsap.fromTo(to.children, { opacity: 0, y: 24 }, { opacity: 1, y: 0, duration: 0.8, ease: 'expo.out', stagger: 0.05 });
  };

  /* ---------- Party size ---------- */
  const partyVal = document.querySelector<HTMLOutputElement>('[data-party-value]')!;
  const partyBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-party]'));
  const partyHint = document.querySelector<HTMLElement>('[data-party-hint]')!;
  const renderParty = () => {
    partyVal.value = String(state.party);
    partyBtns[0].disabled = state.party <= 1;
    partyBtns[1].disabled = state.party >= MAX_PARTY;
    partyHint.innerHTML =
      state.party >= MAX_PARTY
        ? 'For 9 or more guests, please see <a href="../private-dining/" style="color:var(--accent-strong);text-decoration:underline">Private Dining</a>.'
        : 'Up to 8 guests online.';
    renderSlots();
  };
  partyBtns.forEach((b) =>
    b.addEventListener('click', () => {
      state.party = Math.min(MAX_PARTY, Math.max(1, state.party + Number(b.dataset.party)));
      renderParty();
      if (hasMotion()) gsap.fromTo(partyVal, { y: Number(b.dataset.party) * -10, opacity: 0 }, { y: 0, opacity: 1, duration: 0.4, ease: 'expo.out' });
    }),
  );

  /* ---------- Calendar (roving tabindex grid) ---------- */
  const grid = document.querySelector<HTMLElement>('[data-cal-grid]')!;
  const monthEl = document.querySelector<HTMLElement>('[data-cal-month]')!;
  const prev = document.querySelector<HTMLButtonElement>('[data-cal-prev]')!;
  const next = document.querySelector<HTMLButtonElement>('[data-cal-next]')!;
  let focusDate: Date = new Date(today);
  while (!isBookable(focusDate)) focusDate.setDate(focusDate.getDate() + 1);

  const renderCalendar = (focus = false) => {
    const y = state.view.getFullYear();
    const m = state.view.getMonth();
    monthEl.textContent = state.view.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
    prev.disabled = y === today.getFullYear() && m === today.getMonth();
    next.disabled = new Date(y, m + 1, 1) > lastDay;

    const first = new Date(y, m, 1).getDay();
    const days = new Date(y, m + 1, 0).getDate();
    const cells: string[] = [];
    for (let i = 0; i < first; i++) cells.push('<span class="day-empty" role="gridcell"></span>');
    for (let d = 1; d <= days; d++) {
      const date = new Date(y, m, d);
      const ok = isBookable(date);
      const selected = state.date && sameDay(date, state.date);
      const isFocus = sameDay(date, focusDate);
      const label = `${fmtLong(date)}${isClosed(date) ? ', closed' : !ok ? ', unavailable' : ''}`;
      cells.push(
        `<span role="gridcell" aria-selected="${selected ? 'true' : 'false'}"><button type="button" class="day${sameDay(date, today) ? ' is-today' : ''}" data-date="${date.toISOString()}" aria-label="${label}${selected ? ', selected' : ''}" ${sameDay(date, today) ? 'aria-current="date"' : ''} ${ok ? '' : 'aria-disabled="true"'} tabindex="${isFocus ? 0 : -1}">${d}</button></span>`,
      );
    }
    // Wrap in rows for a valid grid structure
    const rows: string[] = [];
    for (let i = 0; i < cells.length; i += 7) rows.push(`<div class="cal-row" role="row">${cells.slice(i, i + 7).join('')}</div>`);
    grid.innerHTML = rows.join('');
    if (!grid.querySelector('[tabindex="0"]')) grid.querySelector<HTMLElement>('.day')?.setAttribute('tabindex', '0');
    if (focus) grid.querySelector<HTMLElement>('[tabindex="0"]')?.focus();
  };

  const moveFocus = (deltaDays: number) => {
    const d = new Date(focusDate);
    d.setDate(d.getDate() + deltaDays);
    if (d < today || d > lastDay) return;
    focusDate = d;
    if (d.getMonth() !== state.view.getMonth() || d.getFullYear() !== state.view.getFullYear()) {
      state.view = new Date(d.getFullYear(), d.getMonth(), 1);
    }
    renderCalendar(true);
  };

  const errDate = document.querySelector<HTMLElement>('[data-err="date"]')!;
  grid.addEventListener('click', (e) => {
    const btn = (e.target as Element).closest<HTMLButtonElement>('.day');
    if (!btn || btn.getAttribute('aria-disabled') === 'true') return;
    state.date = new Date(btn.dataset.date!);
    focusDate = new Date(state.date);
    state.time = '';
    errDate.textContent = '';
    renderCalendar(true);
    renderSlots();
  });
  grid.addEventListener('keydown', (e) => {
    const map: Record<string, number> = { ArrowLeft: -1, ArrowRight: 1, ArrowUp: -7, ArrowDown: 7 };
    if (e.key in map) {
      e.preventDefault();
      moveFocus(map[e.key]);
    }
  });
  prev.addEventListener('click', () => {
    state.view = new Date(state.view.getFullYear(), state.view.getMonth() - 1, 1);
    renderCalendar();
  });
  next.addEventListener('click', () => {
    state.view = new Date(state.view.getFullYear(), state.view.getMonth() + 1, 1);
    renderCalendar();
  });

  /* ---------- Time slots (simulated, deterministic per date + party) ---------- */
  const slotsEl = document.querySelector<HTMLElement>('[data-slots]')!;
  const errTime = document.querySelector<HTMLElement>('[data-err="time"]')!;
  const dateLabel = document.querySelector<HTMLElement>('[data-date-label]')!;

  const times = () => {
    const out: string[] = [];
    const isLate = state.date && [5, 6].includes(state.date.getDay());
    const start = state.date?.getDay() === 0 ? 16.5 : 17;
    const end = isLate ? 22 : 21;
    for (let t = start; t <= end; t += 0.25) {
      const h = Math.floor(t);
      const m = Math.round((t - h) * 60);
      out.push(`${h}:${String(m).padStart(2, '0')}`);
    }
    return out;
  };
  const to12 = (t: string) => {
    const [h, m] = t.split(':').map(Number);
    return `${h > 12 ? h - 12 : h}:${String(m).padStart(2, '0')} pm`;
  };
  const seeded = (s: string) => {
    let h = 2166136261;
    for (let i = 0; i < s.length; i++) h = Math.imul(h ^ s.charCodeAt(i), 16777619);
    return (h >>> 0) / 4294967295;
  };

  function renderSlots() {
    if (!state.date) {
      slotsEl.innerHTML = '';
      return;
    }
    dateLabel.textContent = `${fmtLong(state.date)} · ${state.party} ${state.party === 1 ? 'guest' : 'guests'}`;
    const list = times();
    let html = '';
    let period = '';
    list.forEach((t) => {
      const h = Number(t.split(':')[0]);
      const p = h < 19 ? 'Early evening' : h < 21 ? 'Prime time' : 'Late';
      if (p !== period) {
        period = p;
        html += `<p class="slots__period" aria-hidden="true">${p}</p>`;
      }
      const busy = seeded(`${state.date!.toDateString()}-${t}-${state.party}`) < (p === 'Prime time' ? 0.55 : 0.25);
      const checked = state.time === t;
      html += `<button type="button" role="radio" class="slot" data-time="${t}" aria-checked="${checked}" ${busy ? 'aria-disabled="true"' : ''} tabindex="-1" aria-label="${to12(t)}${busy ? ', fully booked' : ''}">${to12(t)}</button>`;
    });
    slotsEl.innerHTML = html;
    const radios = Array.from(slotsEl.querySelectorAll<HTMLButtonElement>('.slot'));
    const focusable = radios.find((r) => r.getAttribute('aria-checked') === 'true') ?? radios.find((r) => !r.hasAttribute('aria-disabled'));
    if (focusable) focusable.tabIndex = 0;
  }

  slotsEl.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('.slot');
    if (!b || b.hasAttribute('aria-disabled')) return;
    selectSlot(b);
  });
  const selectSlot = (b: HTMLButtonElement) => {
    state.time = b.dataset.time!;
    errTime.textContent = '';
    slotsEl.querySelectorAll<HTMLButtonElement>('.slot').forEach((s) => {
      s.setAttribute('aria-checked', String(s === b));
      s.tabIndex = s === b ? 0 : -1;
    });
    b.focus();
  };
  slotsEl.addEventListener('keydown', (e) => {
    if (!['ArrowRight', 'ArrowDown', 'ArrowLeft', 'ArrowUp'].includes(e.key)) return;
    e.preventDefault();
    const avail = Array.from(slotsEl.querySelectorAll<HTMLButtonElement>('.slot:not([aria-disabled])'));
    const i = avail.indexOf(document.activeElement as HTMLButtonElement);
    const dir = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : -1;
    const nextBtn = avail[(i + dir + avail.length) % avail.length];
    if (nextBtn) selectSlot(nextBtn);
  });

  /* ---------- Next / Back ---------- */
  form.querySelectorAll<HTMLButtonElement>('[data-next]').forEach((b) =>
    b.addEventListener('click', () => {
      const to = Number(b.dataset.next);
      if (to === 2 && !state.date) {
        errDate.textContent = 'Please choose a date to continue.';
        grid.querySelector<HTMLElement>('[tabindex="0"]')?.focus();
        return;
      }
      if (to === 3 && !state.time) {
        errTime.textContent = 'Please choose an available time.';
        slotsEl.querySelector<HTMLElement>('[tabindex="0"]')?.focus();
        return;
      }
      if (to === 3) renderSummary();
      goTo(to);
    }),
  );
  form.querySelectorAll<HTMLButtonElement>('[data-back]').forEach((b) => b.addEventListener('click', () => goTo(Number(b.dataset.back))));

  const seating = () => (new FormData(form).get('seating') as string) || 'Dining Room';
  const summaryEl = document.querySelector<HTMLElement>('[data-summary]')!;
  const renderSummary = () => {
    summaryEl.innerHTML = `<span><strong>${fmtLong(state.date!)}</strong></span><span>at <strong>${to12(state.time)}</strong></span><span><strong>${state.party}</strong> ${state.party === 1 ? 'guest' : 'guests'}</span><span><strong>${seating()}</strong></span>`;
  };

  /* ---------- Submit ---------- */
  enhanceForm(form);
  const statusEl = form.querySelector<HTMLElement>('[data-form-status]')!;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    statusEl.textContent = '';
    if (!validateForm(form, steps[2])) {
      statusEl.textContent = 'Please complete the highlighted fields.';
      return;
    }
    const btn = form.querySelector<HTMLButtonElement>('[data-submit]');
    setLoading(btn, true);
    await fakeRequest(1400);
    setLoading(btn, false);

    const data = new FormData(form);
    const ref = 'EO-' + Math.random().toString(36).slice(2, 7).toUpperCase();
    confirmEl.querySelector('[data-ref]')!.textContent = ref;
    confirmEl.querySelector('[data-c-name]')!.textContent = String(data.get('first'));
    confirmEl.querySelector('[data-c-email]')!.textContent = String(data.get('email'));
    confirmEl.querySelector('[data-c-details]')!.innerHTML = [
      ['Date', state.date!.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' })],
      ['Time', to12(state.time)],
      ['Guests', String(state.party)],
      ['Seating', seating()],
    ]
      .map(([k, v]) => `<div><dt>${k}</dt><dd>${v}</dd></div>`)
      .join('');

    form.hidden = true;
    document.querySelector<HTMLElement>('.steps')!.hidden = true;
    confirmEl.hidden = false;
    confirmEl.focus({ preventScroll: true });
    scrollToEl(confirmEl, -140);
    if (hasMotion()) {
      gsap.from(confirmEl.querySelector('.confirm__seal'), { scale: 0, rotate: -90, duration: 1.2, ease: 'elastic.out(1, 0.55)' });
      gsap.from(Array.from(confirmEl.children).slice(1), { opacity: 0, y: 24, duration: 0.9, ease: 'expo.out', stagger: 0.07, delay: 0.15 });
    }
  });

  /* ---------- Calendar file (.ics) — fully functional ---------- */
  confirmEl.querySelector('[data-ics]')!.addEventListener('click', () => {
    const [h, m] = state.time.split(':').map(Number);
    const start = new Date(state.date!);
    start.setHours(h, m, 0, 0);
    const end = new Date(start.getTime() + 2.5 * 3600 * 1000);
    const stamp = (d: Date) => d.toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, '');
    const ics = [
      'BEGIN:VCALENDAR',
      'VERSION:2.0',
      'PRODID:-//Ember & Oak//Demo//EN',
      'BEGIN:VEVENT',
      `UID:${Date.now()}@emberandoak.example`,
      `DTSTAMP:${stamp(new Date())}`,
      `DTSTART:${stamp(start)}`,
      `DTEND:${stamp(end)}`,
      `SUMMARY:Dinner at Ember & Oak (${state.party} guests) - DEMO`,
      'LOCATION:Ember & Oak (demo address)\\, Seattle\\, WA',
      'DESCRIPTION:Demonstration booking. No reservation was made.',
      'END:VEVENT',
      'END:VCALENDAR',
    ].join('\r\n');
    const blob = new Blob([ics], { type: 'text/calendar' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'ember-and-oak-reservation.ics';
    a.dataset.noTransition = '';
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(a.href), 1000);
  });

  confirmEl.querySelector('[data-restart]')!.addEventListener('click', () => {
    form.reset();
    state.date = null;
    state.time = '';
    state.party = 2;
    confirmEl.hidden = true;
    form.hidden = false;
    document.querySelector<HTMLElement>('.steps')!.hidden = false;
    steps.forEach((s, i) => (s.hidden = i !== 0));
    current = 2;
    renderParty();
    renderCalendar();
    goTo(1);
  });

  renderParty();
  renderCalendar();
</script>
